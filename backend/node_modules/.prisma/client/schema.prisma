generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String?
  name          String   @default("Student")
  language      String   @default("en")
  learningLevel String   @default("intermediate")
  refreshToken  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  chatSessions   ChatSession[]
  studyGoals     StudyGoal[]
  progress       ProgressTracker?
  practiceTests  PracticeTest[]
  studyMaterials StudyMaterial[]
  settings       Settings?
  studySessions  StudySession[]
  analytics      Analytics[]
}

model Settings {
  id            String   @id @default(cuid())
  userId        String   @unique
  theme         String   @default("system")
  notifications Boolean  @default(true)
  emailAlerts   Boolean  @default(true)
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id        String    @id @default(cuid())
  userId    String
  title     String    @default("New Chat")
  status    String    @default("active") // active, archived, deleted
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id            String      @id @default(cuid())
  chatSessionId String
  role          String // "user" or "ai" or "system"
  content       String
  createdAt     DateTime    @default(now())
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
}

model StudyGoal {
  id          String    @id @default(cuid())
  userId      String
  subject     String
  weeklyGoal  String
  scoreTarget Int
  completed   Boolean   @default(false)
  deadline    DateTime?
  milestones  String? // Stored as JSON string
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProgressTracker {
  id                 String   @id @default(cuid())
  userId             String   @unique
  subjectWise        String // Stored as JSON string to keep it simple for SQLite
  studyHours         Float    @default(0)
  completedGoals     Int      @default(0)
  completedTests     Int      @default(0)
  learningActivities Int      @default(0)
  dailyStats         String? // JSON string
  weeklyStats        String? // JSON string
  monthlyStats       String? // JSON string
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudySession {
  id       String   @id @default(cuid())
  userId   String
  subject  String
  duration Int // in minutes
  date     DateTime @default(now())
  notes    String?
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Analytics {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @default(now())
  metric String // e.g., "hours_studied", "goals_completed"
  value  Float
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PracticeTest {
  id             String   @id @default(cuid())
  userId         String
  subject        String
  chapter        String
  questionsCount Int
  difficulty     String
  correctAnswers Int      @default(0)
  wrongAnswers   Int      @default(0)
  finalScore     Int      @default(0)
  completed      Boolean  @default(false)
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudyMaterial {
  id            String   @id @default(cuid())
  userId        String
  fileName      String
  filePath      String // Path or URL to the uploaded file
  chatSessionId String? // Optional link to a specific chat session
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
